/*
        regexp.ccm
        Compile-time symbolic regular expression building.

        Example:
        auto digit = regexp::range('0', '9');     // [0-9]
        auto number = regexp::one_or_more(digit); // [0-9]+
*/

export module trick.regexp;
import std;

namespace trick::regexp::detail {

}

export namespace trick::regexp {

template<class C>
class atom {
public:
        constexpr atom(C) noexcept;

private:
        C atom_char;
};

template<class... Cs>
class one_of {
public:
        constexpr one_of(Cs...) noexcept;

private:
        std::tuple<Cs...> chars;
};

template<class... Cs>
class not_one_of {
public:
        constexpr not_one_of(Cs...) noexcept;

private:
        std::tuple<Cs...> chars;
};

template<class C>
class range {
public:
        constexpr range(C, C) noexcept;

private:
        C begin;
        C end;
};

template<class... Exps>
class any {
public:
        constexpr any(Exps...) noexcept;

private:
        std::tuple<Exps...> expressions;
};

template<class Exp>
class zero_or_one {
public:
        constexpr zero_or_one(Exp) noexcept;

private:
        Exp expression;
};

template<class Exp>
class zero_or_more {
public:
        constexpr zero_or_more(Exp) noexcept;

private:
        Exp expression;
};

template<class Exp>
class one_or_more {
public:
        constexpr one_or_more(Exp) noexcept;

private:
        Exp expression;
};

template<class... Exps>
class sequence {
public:
        constexpr sequence(Exps...) noexcept;

private:
        std::tuple<Exps...> expressions;
};

template<class C>
constexpr atom<C>::atom(C atom_char) noexcept
        : atom_char(atom_char) {}

template<class... Cs>
constexpr one_of<Cs...>::one_of(Cs... chars) noexcept
        : chars(chars...) {}

template<class... Cs>
constexpr not_one_of<Cs...>::not_one_of(Cs... chars) noexcept
        : chars(chars...) {}

template<class C>
constexpr range<C>::range(C begin, C end) noexcept
        : begin(begin), end(end) {}

template<class... Exps>
constexpr any<Exps...>::any(Exps... expressions) noexcept
        : expressions(expressions...) {}

template<class Exp>
constexpr zero_or_one<Exp>::zero_or_one(Exp expression) noexcept
        : expression(expression) {}

template<class Exp>
constexpr zero_or_more<Exp>::zero_or_more(Exp expression) noexcept
        : expression(expression) {}

template<class Exp>
constexpr one_or_more<Exp>::one_or_more(Exp expression) noexcept
        : expression(expression) {}

template<class... Exps>
constexpr sequence<Exps...>::sequence(Exps... expressions) noexcept
        : expressions(expressions...) {}

constexpr auto digit = range('0', '9');
constexpr auto lower = range('a', 'z');
constexpr auto upper = range('A', 'Z');
constexpr auto alpha = any(lower, upper);
constexpr auto alphanum = any(digit, alpha);

}
