/*
        state_machine.ccm
        Compile-time state machine building from symbolic regular expressions.

        Example:
        next_state = state_machine.transition(state, input);
        bool is_error = state_machine.is_error(next_state);
        bool is_final = state_machine.is_final(next_state);
*/

export module state_machine;
import std;
import regexp;

export namespace trick::state_machine {

template<class T, regexp::regexp... Rs>
using description = std::tuple<std::pair<Rs, T>...>;

} // trick::state_machine

namespace trick::state_machine::detail { // detail for atomic alphabet construction

using char_type = regexp::char_type;
using char_range = std::pair<char_type, char_type>;
using char_ranges = std::set<char_range>;
using flat_char_ranges = std::vector<char_range>;
using symbol = int;

class atomic_alphabet {
public:
        template<class R>
        constexpr atomic_alphabet(R&&) noexcept;

        constexpr symbol to_symbol(const char_type&) const noexcept;
        constexpr std::vector<symbol> to_symbols(const char_range&) const noexcept;
        constexpr std::vector<symbol> all_symbols() const noexcept;

private:
        flat_char_ranges ranges;
};

template<class S>
constexpr atomic_alphabet::atomic_alphabet(S&& ranges) noexcept
        : ranges(ranges) {}

constexpr symbol atomic_alphabet::to_symbol(const char_type& ch) const noexcept {

        return std::ranges::distance(
                ranges.begin(),
                std::ranges::find(ranges, ch, &char_range::first)
        );
}

constexpr std::vector<symbol> atomic_alphabet::to_symbols(const char_range& range) const noexcept {

        auto [first, second] = range;
        symbol first_sym = std::ranges::distance(
                ranges.begin(), std::ranges::find(ranges, first, &char_range::first)
        );
        symbol second_sym = std::ranges::distance(
                ranges.begin(), std::ranges::find(ranges, second, &char_range::second)
        );
        return std::vector{std::from_range, std::views::iota(first_sym, second_sym + 1)};
}

constexpr std::vector<symbol> atomic_alphabet::all_symbols() const noexcept {

        symbol start{0}, end = ranges.size();
        return std::vector{std::from_range, std::views::iota(start, end)};
}

template<regexp::regexp_char C>
constexpr detail::char_ranges collect_char_ranges(const regexp::atom<C>& atom) {

        return detail::char_ranges{ {atom.atom_char, atom.atom_char} };
}

template<regexp::regexp_char C, int N>
constexpr detail::char_ranges collect_char_ranges(const regexp::literal<C, N>& literal) {

        auto [...chars] = literal.chars;
        return detail::char_ranges{ {chars, chars}... };
}

template<regexp::regexp_char C>
constexpr detail::char_ranges collect_char_ranges(const regexp::range<C>& range) {

        return detail::char_ranges{ {range.begin, range.end} };
}

// forward declaration for top-level collect_char_ranges
template<regexp::regexp... Rs>
constexpr detail::char_ranges collect_char_ranges(const Rs&...);

template<template<class...> class R, regexp::regexp... Exps>
constexpr detail::char_ranges collect_char_ranges(const R<Exps...>& subexpr_regexp) {

        const auto& [...regexps] = subexpr_regexp.subexpr;
        return detail::collect_char_ranges(regexps...);
}

template<regexp::regexp... Rs>
constexpr detail::char_ranges collect_char_ranges(const Rs&... regexps) {

        detail::char_ranges char_ranges{};
        template for (auto regex : {regexps...}) {
                char_ranges.insert_range(detail::collect_char_ranges(regex));
        }

        return char_ranges;
}

template<regexp::regexp... Rs>
constexpr detail::flat_char_ranges reduce_alphabet(const Rs&... regexps) {

        detail::char_ranges all_char_ranges = detail::collect_char_ranges(regexps...);

        if (all_char_ranges.empty()) {
                return {};
        }

        std::set<char_type> canonical_bounds;
        std::ranges::for_each(all_char_ranges, [&canonical_bounds](auto&& range) {
                canonical_bounds.insert({ range.first, range.second + 1 });
        });

        detail::flat_char_ranges disjoint_char_ranges;
        auto sliding_window = std::views::slide(canonical_bounds, 2);

        std::ranges::for_each(sliding_window, [&disjoint_char_ranges](auto&& range) {
                auto cur = *range.begin();
                auto next = *std::next(range.begin());
                if (cur < next) { disjoint_char_ranges.emplace_back(cur, next - 1); }
        });

        return disjoint_char_ranges;
}

template<regexp::regexp... Rs>
constexpr detail::atomic_alphabet make_atomic_alphabet(const Rs&... regexps) {

        return detail::atomic_alphabet(reduce_alphabet(regexps...));
}

} // trick::state_machine::detail

namespace trick::state_machine::detail { // detail for tagged nfa building

using state_id = int;

class state_allocator {
public:
        constexpr state_allocator() = default;
        constexpr state_id allocate() { return next++; }

private:
        state_id next{0};
};

struct nfa {

        struct transition {
                state_id from{};
                state_id to{};
                std::optional<symbol> sym{std::nullopt};
        };

        state_id start;
        state_id end;
        std::vector<transition> transitions;
};

template<class T>
struct tagged_nfa {

        using tag = T;
        using transition = nfa::transition;

        struct accepting {
                state_id id;
                tagged_nfa::tag tag;
        };

        state_id start;
        std::vector<accepting> ends{};
        std::vector<transition> transitions{};
};

constexpr detail::nfa build_epsilon(state_allocator& alloc) noexcept {

        state_id start{alloc.allocate()}, end{alloc.allocate()};
        return detail::nfa{
                .start = start,
                .end = end,
                .transitions = { {start, end} }
        };
}

constexpr detail::nfa build_symbol(symbol symbol, state_allocator& alloc) noexcept {

        state_id start{alloc.allocate()}, end{alloc.allocate()};
        return detail::nfa{
                .start = start,
                .end = end,
                .transitions = { {start, end, symbol} }
        };
}

constexpr detail::nfa
build_union(const detail::nfa& nfa1, const detail::nfa& nfa2, state_allocator& alloc) noexcept {

        state_id start{alloc.allocate()}, end{alloc.allocate()};

        detail::nfa nfa{
                .start = start,
                .end = end,
                .transitions = {
                        {start, nfa1.start},
                        {start, nfa2.start},
                        {nfa1.end, end},
                        {nfa2.end, end}
                }
        };
        nfa.transitions.append_range(std::views::concat(
                nfa1.transitions,
                nfa2.transitions
        ));
        return nfa;
}

constexpr detail::nfa
build_concat(const detail::nfa& nfa1, const detail::nfa& nfa2) noexcept {

        detail::nfa nfa{
                .start = nfa1.start,
                .end = nfa2.end,
                .transitions = { {nfa1.end, nfa2.start} }
        };
        nfa.transitions.append_range(std::views::concat(
                nfa1.transitions,
                nfa2.transitions
        ));
        return nfa;
}

constexpr detail::nfa
build_kleene_star(const detail::nfa& inner, state_allocator& alloc) noexcept {

        state_id start{alloc.allocate()}, end{alloc.allocate()};
        detail::nfa nfa{
                .start = start,
                .end = end,
                .transitions = {
                        {start, inner.start},
                        {inner.end, inner.start},
                        {inner.end, end},
                        {start, end}
                }
        };
        nfa.transitions.append_range(inner.transitions);
        return nfa;
}

constexpr detail::nfa
build_one_or_more(const detail::nfa& inner, state_allocator& alloc) noexcept {

        state_id start{alloc.allocate()}, end{alloc.allocate()};
        detail::nfa nfa{
                .start = start,
                .end = end,
                .transitions = {
                        {start, inner.start},
                        {inner.end, inner.start},
                        {inner.end, end}
                }
        };
        nfa.transitions.append_range(inner.transitions);
        return nfa;
}

template<regexp::regexp_char C, class A>
constexpr detail::nfa
thompson_construction
        (const regexp::atom<C>& atom, const A& alphabet, state_allocator& alloc)
noexcept {

        detail::symbol sym = alphabet.to_symbol(atom.atom_char);
        return build_symbol(sym, alloc);
}

template<regexp::regexp_char C, int N, class A>
constexpr detail::nfa
thompson_construction
        (const regexp::literal<C, N>& literal, const A& alphabet, state_allocator& alloc)
noexcept {

        auto [first, ...rest] = literal.chars;
        detail::nfa nfa = build_symbol(alphabet.to_symbol(first), alloc);

        template for (char_type next : {rest...}) {
                nfa = build_concat(nfa, build_symbol(alphabet.to_symbol(next), alloc));
        }
        return nfa;
}

template<regexp::regexp_char C, class A>
constexpr detail::nfa
thompson_construction
        (const regexp::range<C>& range, const A& alphabet, state_allocator& alloc)
noexcept {

        std::vector<detail::symbol> syms = alphabet.to_symbols({range.begin, range.end});

        detail::nfa nfa = build_symbol(syms.front(), alloc);
        std::ranges::for_each(std::views::drop(syms, 1), [&](auto&& sym) {
                nfa = detail::build_union(nfa, build_symbol(sym, alloc), alloc);
        });
        return nfa;
}

template<regexp::regexp... Exps, class A>
constexpr detail::nfa
thompson_construction
        (const regexp::any<Exps...>& any, const A& alphabet, state_allocator& alloc)
noexcept {

        auto [regexp, ...rest] = any.subexpr;
        detail::nfa nfa = thompson_construction(regexp, alphabet, alloc);

        template for (auto regexp : {rest...}) {
                nfa = detail::build_union(nfa, thompson_construction(regexp, alphabet, alloc), alloc);
        }
        return nfa;
}

template<regexp::regexp Exp, class A>
constexpr detail::nfa
thompson_construction
        (const regexp::zero_or_one<Exp>& zero_or_one, const A& alphabet, state_allocator& alloc)
noexcept {

        auto regexp = zero_or_one.subexpr;
        return detail::build_union(
                detail::build_epsilon(alloc),
                thompson_construction(regexp, alphabet, alloc),
                alloc
        );
}

template<regexp::regexp Exp, class A>
constexpr detail::nfa
thompson_construction
        (const regexp::zero_or_more<Exp>& zero_or_more, const A& alphabet, state_allocator& alloc)
noexcept {

        auto regexp = zero_or_more.subexpr;
        return detail::build_kleene_star(
                thompson_construction(regexp, alphabet, alloc),
                alloc
        );
}

template<regexp::regexp Exp, class A>
constexpr detail::nfa
thompson_construction
        (const regexp::one_or_more<Exp>& one_or_more, const A& alphabet, state_allocator& alloc)
noexcept {

        auto regexp = one_or_more.subexpr;
        return detail::build_one_or_more(
                thompson_construction(regexp, alphabet, alloc),
                alloc
        );
}

template<regexp::regexp... Exps, class A>
constexpr detail::nfa
thompson_construction
        (const regexp::concat<Exps...> concat, const A& alphabet, state_allocator& alloc)
noexcept {

        auto [regexp, ...rest] = concat.subexpr;
        detail::nfa nfa = thompson_construction(regexp, alphabet, alloc);
        template for (auto regexp : {rest...}) {
                nfa = build_concat(nfa, thompson_construction(regexp, alphabet, alloc));
        }
        return nfa;
}

template<class T, regexp::regexp... Rs, class A>
constexpr detail::tagged_nfa<T>
thompson_construction
        (const description<T, Rs...>& description, const A& alphabet)
noexcept {

        auto [...pairs] = description;
        state_allocator alloc{};
        detail::tagged_nfa<T> final_nfa{ .start = alloc.allocate() };

        template for (auto&& [regexp, tag] : {pairs...}) {
                detail::nfa sub_nfa = thompson_construction(regexp, alphabet, alloc);
                final_nfa.transitions.append_range(sub_nfa.transitions);
                final_nfa.transitions.emplace_back(final_nfa.start, sub_nfa.start);
                final_nfa.ends.emplace_back(sub_nfa.end, tag);
        }
        return final_nfa;
}

} // trick::state_machine::detail

namespace trick::state_machine::detail { // detail for tagged dfa construction

using state_set = std::set<state_id>;

template<class T>
struct tagged_dfa {

        using tag = T;

        struct transition {
                state_set from;
                state_set to;
                symbol sym;
        };

        struct accepting {
                state_set state;
                std::vector<tagged_dfa::tag> tag;
        };

        state_set start;
        std::vector<accepting> ends{};
        std::vector<transition> transitions{};
};

template<class N>
constexpr state_set
epsilon_closure(const N& nfa, const state_set& from) noexcept {

        state_set closure{};
        std::stack<state_id> checklist{std::from_range, from};

        while (not checklist.empty()) {
                state_id state = checklist.top();
                checklist.pop();
                if (not closure.insert(state).second) { continue; }

                auto epsilon_transitions = std::views::filter(
                        nfa.transitions,
                        [=](const auto& trans) { return trans.from == state and not trans.sym.has_value(); }
                );
                checklist.push_range(
                        std::views::transform(epsilon_transitions, &N::transition::to)
                );
        }
        return closure;
}

template<class N>
constexpr state_set
symbol_reachable(const N& nfa, const state_set& from, symbol sym) noexcept {

        state_set reachable{};
        std::ranges::for_each(from, [&](state_id state) {

                auto symbol_transitions = std::views::filter(
                        nfa.transitions,
                        [=](const auto& trans) { return trans.from == state and trans.sym == sym; }
                );
                reachable.insert_range(
                        std::views::transform(symbol_transitions, &N::transition::to)
                );
        });
        return reachable;
}

template<class T>
constexpr void
add_symbol_transition(
        const detail::tagged_nfa<T>& nfa,
        detail::tagged_dfa<T>& dfa,
        std::stack<state_set>& checklist,
        const state_set& state,
        symbol sym
) noexcept {

        state_set reachable = detail::epsilon_closure(nfa, detail::symbol_reachable(nfa, state, sym));
        checklist.push(reachable);
        dfa.transitions.emplace_back(state, reachable, sym);

        auto tags = std::views::all(nfa.ends)
                  | std::views::filter([&](auto accepting) { return reachable.contains(accepting.id); })
                  | std::views::transform(&tagged_nfa<T>::accepting::tag)
                  | std::ranges::to<std::vector>();
        if (not tags.empty()) { dfa.ends.emplace_back(reachable, tags); }
}

template<class T, class A>
constexpr detail::tagged_dfa<T>
subset_construction(const detail::tagged_nfa<T> nfa, const A& alphabet) noexcept {

        std::vector<symbol> all_syms = alphabet.all_symbols();
        detail::tagged_dfa<T> dfa{ .start = detail::epsilon_closure(nfa, {nfa.start})};

        std::set<state_set> complete;
        std::stack<state_set> checklist(std::from_range, std::views::single(dfa.start));

        while (not checklist.empty()) {
                state_set state = checklist.top();
                checklist.pop();
                if (not complete.insert(state).second) { continue; }

                std::ranges::for_each(all_syms, [&](symbol sym) {
                        detail::add_symbol_transition(nfa, dfa, checklist, state, sym);
                });

        }
        return dfa;
}

} // trick::state_machine::detail

namespace trick::state_machine::detail {

struct state_annotation {
        bool is_final{};
        bool is_error{};
};

} // trick::state_machine::detail

export namespace trick::state_machine {

class state_machine {
public:
        using state = int;
        using symbol = int;

        template<class T, regexp::regexp... Rs>
        constexpr state_machine(const description<T, Rs...>& description) noexcept;

        constexpr state start_state() const noexcept;
        constexpr state transition(state current, symbol input) const noexcept;

        constexpr bool is_final(state state) const noexcept;
        constexpr bool is_error(state state) const noexcept;

        constexpr std::span<const state> matches(state state) const noexcept;

private:
        state first_state{};
        std::size_t num_states{}, num_symbols{};

        std::span<state> transition_table;
        std::span<detail::state_annotation> annotations;
};

template<class T, regexp::regexp... Rs>
constexpr state_machine::state_machine(const description<T, Rs...>& description) noexcept {

}

constexpr state_machine::state state_machine::start_state() const noexcept {
        return first_state;
}

constexpr state_machine::state
state_machine::transition(state_machine::state current, state_machine::symbol input)
const noexcept {
        return transition_table[current * num_symbols + input];
}

constexpr bool state_machine::is_final(state_machine::state state) const noexcept {
        return annotations[state].is_final;
}

constexpr bool state_machine::is_error(state_machine::state state) const noexcept {
        return annotations[state].is_error;
}

} // trick::state_machine
