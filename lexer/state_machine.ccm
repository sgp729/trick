/*
        state_machine.ccm
        Compile-time state machine building from symbolic regular expressions.

        Example:
        next_state = state_machine.transition(state, input);
        bool is_error = state_machine.is_error(next_state);
        bool is_final = state_machine.is_final(next_state);
*/

export module state_machine;
import std;
import regexp;

export namespace trick::state_machine {

template<class T, regexp::regexp... Rs>
using description = std::tuple<std::pair<Rs, T>...>;

}

namespace trick::state_machine::detail {

using char_type = regexp::char_type;
using char_range = std::pair<char_type, char_type>;

struct pair_hash {
        bool operator()(const char_range& p) {
                return std::hash<char_type>{}(p.first)
                     ^ std::hash<char_type>{}(p.second);
        }
};
using char_ranges = std::unordered_set<char_range, pair_hash>;

template<regexp::regexp_char C>
consteval detail::char_ranges collect_char_ranges(const regexp::atom<C>& atom) {
        return detail::char_ranges{ {atom.atom_char, atom.atom_char} };
}

template<regexp::regexp... Rs>
consteval auto collect_char_ranges(Rs... regexps) {

        detail::char_ranges char_ranges{};
        template for (auto regex : {regexps...}) {
                char_ranges.insert_range(detail::collect_char_ranges(regex));
        }

        return char_ranges;
}

template<regexp::regexp... Rs>
consteval auto reduce_alphabet(Rs... regexes) {

        // auto all_char_ranges = detail::collect_char_ranges(regexes);
}

}

export namespace trick::state_machine {

class state_machine {
public:
        template<class T, regexp::regexp... Rs>
        consteval state_machine(description<T, Rs...> description) noexcept;
};

template<class T, regexp::regexp... Rs>
consteval state_machine::state_machine(description<T, Rs...> description) noexcept {

        auto [...desc_pairs] = description;
        auto [...regexes] = { desc_pairs.first... };

        auto reduced_alphabet = detail::reduce_alphabet(regexes...);

        // auto nfa = detail::construct_nfa(description, reduced_alphabet);
        // auto dfa = detail::construct_dfa(nfa);

        // *some_internal_state* = detail::move_to_static_storage(dfa);
}

}
