/*
        automata/rules.ccm
        Set of tools for compile-time definition of context-free grammar rules

        Example:
        // Define left-associative grammar for addition (E -> E + id | id)
        trick::automata::rules rules;
        rules.variable("id") = token_kind::id;
        rules.variable("plus") = token_kind::plus;
        rules.variable("expr") = rules.any(rules.concat("expr", "plus", "id"), "id");
*/

export module trick.automata;
import std;

namespace trick::automata {

template<class S> struct terminal { S symbol; };
template<class I> struct concat { std::vector<I> rule_indexes; };
template<class I> struct any { std::vector<I> rule_indexes; };
template<class I> struct star { I rule_index; };

template<class T, class... Any>
concept one_of = (std::convertible_to<T, Any> || ...);

} // trick::automata

export namespace trick::automata {

template<class Sym>
class rules {
public:
        using symbol = Sym;
        using name = std::string;
        using index = std::uint32_t;

private:
        using rule = std::variant<
                std::monostate,
                automata::terminal<Sym>,
                automata::concat<index>,
                automata::any<index>,
                automata::star<index>,
                index
        >;

        struct rule_proxy {
                index rule_index;
                rules& parent_rules;
                constexpr rule_proxy& operator=(index rule_index);
                constexpr rule_proxy& operator=(symbol symbol);
        };

public:
        constexpr rules() = default;

        constexpr rule_proxy variable(const name& name);

        constexpr index terminal(symbol symbol);
        template<one_of<symbol, name>... T> constexpr index concat(T... inputs);
        template<one_of<symbol, name>... T> constexpr index any(T... inputs);
        template<one_of<symbol, name> T> constexpr index star(T input);

private:
        std::vector<rule> rules_vec;

        std::unordered_map<Sym, index> symbols;
        std::unordered_map<std::string, index> names;

        friend rule_proxy;
};

} // trick::automata

namespace trick::automata {

template<class Sym>
constexpr rules<Sym>::rule_proxy rules<Sym>::variable(const name& name) {

        auto name_it = names.find(name);
        if (name_it == names.end()) {
                index new_idx = rules_vec.size();
                rules_vec.emplace_back();
                std::tie(name_it, std::ignore) = names.emplace(name, new_idx);
        }

        index idx = name_it->second;
        return rule_proxy{idx, *this};
}

template<class Sym>
constexpr rules<Sym>::index rules<Sym>::terminal(symbol symbol) {

        auto symbol_it = symbols.find(symbol);
        if (symbol_it == symbols.end()) {
                index new_idx = rules_vec.size();
                rules_vec.push_back(automata::terminal<Sym>(symbol));
                std::tie(symbol_it, std::ignore) = symbols.emplace(symbol, new_idx);
        }

        return symbol_it->second;
}

template<class Sym>
template<one_of<typename rules<Sym>::symbol, typename rules<Sym>::name>... T>
constexpr rules<Sym>::index rules<Sym>::concat(T... inputs) {

        automata::concat<index> cat{};

        template for (auto input : {inputs...}) {
                if constexpr (std::is_same_v<decltype(input), symbol>) {
                        cat.rule_indexes.push_back(terminal(input));
                } else {
                        cat.rule_indexes.push_back(variable(input).rule_index);
                }
        }

        index new_idx = rules_vec.size();
        rules_vec.push_back(cat);

        return new_idx;
}

template<class Sym>
template<one_of<typename rules<Sym>::symbol, typename rules<Sym>::name>... T>
constexpr rules<Sym>::index rules<Sym>::any(T... inputs) {

        automata::any<index> any;

        template for (auto input : {inputs...}) {
                if constexpr (std::is_same_v<decltype(input), symbol>) {
                        any.rule_indexes.push_back(terminal(input));
                } else {
                        any.rule_indexes.push_back(variable(input).rule_index);
                }
        }

        index new_idx = rules_vec.size();
        rules_vec.push_back(any);

        return new_idx;
}

template<class Sym>
template<one_of<typename rules<Sym>::symbol, typename rules<Sym>::name> T>
constexpr rules<Sym>::index rules<Sym>::star(T input) {

        automata::star<index> star{input};
        index new_idx = rules_vec.size();
        rules_vec.push_back(star);

        return new_idx;
}

template<class Sym>
constexpr rules<Sym>::rule_proxy& rules<Sym>::rule_proxy::operator=(index rule_index) {

        auto& rule_ref = parent_rules.rules_vec[this->rule_index];
        if (not std::holds_alternative<std::monostate>(rule_ref)) {
                throw std::invalid_argument("rule cannot be assigned more than once");
        }

        rule_ref = rule_index;
        return *this;
}

template<class Sym>
constexpr rules<Sym>::rule_proxy& rules<Sym>::rule_proxy::operator=(symbol symbol) {

        auto& rule_ref = parent_rules.rules_vec[this->rule_index];
        if (not std::holds_alternative<std::monostate>(rule_ref)) {
                throw std::invalid_argument("rule cannot be assigned more than once");
        }

        rule_ref = parent_rules.terminal(symbol);
        return *this;
}

} // trick::automata
